# Caminhos sem aspas ou com aspas simples (evite escapes de aspas duplas).
# Caminhos relativos são resolvidos a partir da pasta deste projeto.
PASTA_CERTIFICADOS=certificados
LOG_LEVEL=INFO
OCR_ENABLED=true
OCR_LANGUAGE=por
TESSERACT_PATH=
DRY_RUN=false
TITLE_MIN_CONFIDENCE=0.90
OCR_MIN_CONFIDENCE=85
OCR_DPI=300
OCR_TIMEOUT=45
# Região OPCIONAL: x0,y0,x1,y1 relativos à página, origem no canto superior esquerdo.
# Modelo visual 2LR9QCGT: região opcional 0.15,0.47,0.75,0.55 (OCR real pendente).
TITLE_REGION=
MAX_TITLE_CHARS=240
MAX_FILENAME_UNITS=240
